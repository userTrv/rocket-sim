{
  "name": "rocket-sim",
  "version": "1.0.0",
  "private": true,
  "description": "3D rocket launch and flight simulator: fly a two-stage launcher from the pad to low Earth orbit. three.js + TypeScript.",
  "license": "MIT",
  "author": "Kirill Levin",
  "type": "module",
  "packageManager": "pnpm@10.33.4+sha512.1c67b3b359b2d408119ba1ed289f34b8fc3c6873412bec6fd264fbdc82489e510fcbecb9ce9d22dae7f3b76269d8441046014bdca53b9979cd7a561ad631b800",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && pnpm typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^26",
    "@types/three": "0.186.0",
    "eslint": "^10",
    "globals": "^17",
    "typescript": "7.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
